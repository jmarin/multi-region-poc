<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} -- %msg%n</pattern>
    </encoder>
  </appender>

  <!-- Suppress Netty DEBUG messages -->
  <logger name="io.netty" level="INFO"/>
  
  <!-- Suppress AWS SDK DEBUG messages -->
  <logger name="software.amazon.awssdk" level="INFO"/>
  
  <!-- Keep application logs at DEBUG -->
  <logger name="com.jmarin" level="DEBUG"/>
  
  <!-- Pekko logs at INFO -->
  <logger name="org.apache.pekko" level="INFO"/>
  
  <root level="INFO">
    <appender-ref ref="STDOUT"/>
  </root>
  
</configuration>
